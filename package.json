{
	"name": "syng",
	"version": "2.5.1",
	"description": "An open source, cross platform, Chinese study app.",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"bundle:check": "npm run build && node scripts/check-bundle-size.mjs",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck:updater": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --allowImportingTsExtensions --types node scripts/check-updater-artifacts.ts scripts/check-updater-artifacts.test.ts",
		"lint": "eslint src/views",
		"fix-lint": "eslint src/views --fix",
		"format": "prettier --write \"src/views/**/*.{js,ts,svelte}\"",
		"format:check": "prettier --check \"src/views/**/*.{js,ts,svelte}\"",
		"test": "vitest run",
		"test-coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sotch-pr35mac/syng"
	},
	"author": "Preston Wang-Stosur-Bassett",
	"license": "GPL-3.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.0.0",
		"@testing-library/user-event": "^14.6.7",
		"@types/dompurify": "^3.0.5",
		"eslint": "^10.12.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^29.1.0",
		"lucide-svelte": "^1.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.3.0",
		"svelte": "5.56.4",
		"svelte-check": "^4.7.6",
		"svelte-spa-router": "^5.1.0",
		"terser": "^5.51.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.0",
		"@tauri-apps/plugin-cli": "^2.4.1",
		"@tauri-apps/plugin-dialog": "^2.7.0",
		"@tauri-apps/plugin-fs": "^2.4.4",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.9.0",
		"dompurify": "^3.4.16",
		"elastic-scroll-polyfill": "^2.1.0",
		"hanzi-writer": "^3.7.3",
		"marked": "^18.1.0"
	}
}
